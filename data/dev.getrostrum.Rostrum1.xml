<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Rostrum's control interface. Service: dev.getrostrum.Rostrum (the running instance).
  Object: /dev/getrostrum/Rostrum/Control.

  Bus ids are the ids from ListBuses: "stream" and "phones" for the Stream and Headphones masters,
  "mic" for mic gain, then the playback buses of the live scene. Where a bus id is expected, a bus
  name in any case also works. Positions are fader travel: 0 to 1, mic gain 0 to 1.5.

  Calls never open a dialog. SwitchScene and scene actions switch at once; with "Save scene
  changes automatically" off, unsaved fader moves in the scene being left are dropped.

  Errors: dev.getrostrum.Rostrum1.Error.UnknownAction, .NoSuchScene, .NoSuchBus, .InvalidValue,
  .HoldAction (TriggerAction on push_to_talk or push_to_mute).

  Properties are read-only and announced with org.freedesktop.DBus.Properties.PropertiesChanged.
-->
<node>
  <interface name="dev.getrostrum.Rostrum1">
    <!-- True when nothing from the mic reaches the stream: muted, push to mute held or panic. -->
    <property name="MicMuted" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- True when the Stream master is muted, by the user or by panic. -->
    <property name="StreamMuted" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- Panic mute is on (panic_mute). Not saved. -->
    <property name="Panic" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <property name="CurrentScene" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- Rostrum is connected to PipeWire. -->
    <property name="Connected" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- Mic filters are switched on (toggle_mic_filters). Saved. They may still be starting, or
         unable to run on this system; the Mic Filters page says which. -->
    <property name="MicFilters" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- Each playback bus has its own Stream and Headphones levels. False only when Rostrum knows
         this system has one level per bus (PipeWire without spa-node-factory); then the Stream
         level applies to both mixes and StepBusVolume moves only "both". -->
    <property name="PerMixLevels" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- Rostrum Chat Mic is in use: some bus has voice chat set up. Discord and in-game voice
         chat record that mic to hear the sounds sent to it. -->
    <property name="ChatMic" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!-- Runs a hotkey action by id, as if its shortcut was pressed. See ListActions. -->
    <method name="TriggerAction">
      <arg name="id" type="s" direction="in"/>
    </method>
    <!-- For push_to_talk and push_to_mute: on until ReleaseAction, or until the caller leaves the
         bus. Any other action runs once, as with TriggerAction. -->
    <method name="PressAction">
      <arg name="id" type="s" direction="in"/>
    </method>
    <method name="ReleaseAction">
      <arg name="id" type="s" direction="in"/>
    </method>
    <method name="SwitchScene">
      <arg name="name" type="s" direction="in"/>
    </method>
    <!-- busId: a bus id or name, or "stream"/"phones" for the masters. A playback bus sets both
         its levels; "<bus>.phones" or "<bus>.stream" sets one, and a linked bus moves the other by
         the same amount. "<bus>.chat" sets the level of its voice chat sounds (not for the mic, a
         master or a bus that receives Voice). A mix on the mic or a master is InvalidValue. -->
    <method name="SetBusVolume">
      <arg name="busId" type="s" direction="in"/>
      <arg name="position" type="d" direction="in"/>
    </method>
    <method name="SetBusMuted">
      <arg name="busId" type="s" direction="in"/>
      <arg name="muted" type="b" direction="in"/>
    </method>
    <method name="ToggleBusMuted">
      <arg name="busId" type="s" direction="in"/>
    </method>
    <!-- Moves a level by delta (-1..1) from where it is and returns the new level, clamped to 0..1
         (the mic to 1.5). mix "stream" or "phones" moves only that level of a playback bus, even
         when it is linked; unlike SetBusVolume("<bus>.stream"), the other level stays. "both"
         moves both levels by the same amount, as a linked fader does, and returns the Stream
         level. "chat" moves only the bus's voice chat level and returns it. The mic and the
         masters take only "both". A mix other than "both" without PerMixLevels is
         InvalidValue. -->
    <method name="StepBusVolume">
      <arg name="busId" type="s" direction="in"/>
      <arg name="mix" type="s" direction="in"/>
      <arg name="delta" type="d" direction="in"/>
      <arg name="position" type="d" direction="out"/>
    </method>
    <!-- Takes a playback bus off one mix ("stream" or "phones") or puts it back, through its
         destination and mute, and never changes whether it plays in the other mix. On Both it
         becomes the other mix only; on this mix only it is muted. Off this mix, a muted bus is
         unmuted to this mix only, and one on the other mix only becomes Both. With "chat" it
         sets up the bus's voice chat send on the first call (unmuted), then switches it off and
         on, and never moves an app or changes a mix. A mic, a master or a bus that receives
         Voice cannot go to voice chat (InvalidValue). -->
    <method name="ToggleBusInMix">
      <arg name="busId" type="s" direction="in"/>
      <arg name="mix" type="s" direction="in"/>
    </method>
    <method name="SetMicMuted">
      <arg name="muted" type="b" direction="in"/>
    </method>
    <method name="ToggleMicMute"/>
    <method name="SetMicFilters">
      <arg name="on" type="b" direction="in"/>
    </method>
    <method name="ListScenes">
      <arg type="as" direction="out"/>
    </method>
    <!-- (id, name, position, muted) for each fader of the live scene. -->
    <method name="ListBuses">
      <arg type="a(ssdb)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="rostrum::app::BusInfoList"/>
    </method>
    <!-- (id, name, stream, phones, muted, destination) for each ListBuses row, in the same order.
         The mic and the masters repeat their one level and have no destination; playback buses
         have "both", "stream" or "phones". -->
    <method name="ListBusLevels">
      <arg type="a(ssddbs)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="rostrum::app::BusLevelsList"/>
    </method>
    <!-- (id, chat set up, chat muted, chat level) for each playback bus that may go to voice
         chat, in scene order. The level is a fader position, 0 to 1. Absent on a Rostrum that
         predates voice chat. -->
    <method name="ListBusChat">
      <arg type="a(sbbd)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="rostrum::app::BusChatList"/>
    </method>
    <!-- (id, name) for each action: the fixed ones, then mute_bus_<id> for every playback bus
         in any scene. -->
    <method name="ListActions">
      <arg type="a(ss)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="rostrum::app::ActionInfoList"/>
    </method>
  </interface>
</node>
